# ---------------------------------------------------------------------------
# .env.local — written for you by `npx convex dev` in backend/ (local anonymous
# deployment); the web app and the extension build read it too
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=anonymous:anonymous-agent
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# .env.prod.local — git-ignored, read line by line by ../scripts/deploy*.sh
# ---------------------------------------------------------------------------
# CONVEX_DEPLOY_KEY=prod:<production deploy key>

# ---------------------------------------------------------------------------
# Convex deployment env vars: set on EACH deployment with `npx convex env set`
# (add --prod for production), not read from a file
# ---------------------------------------------------------------------------
# JWT_PRIVATE_KEY / JWKS   npm run setup:auth (add --prod for production)
# SITE_URL=http://localhost:5173      (prod: https://pitara.pknspace.com)
# ALLOWED_EMAILS=you@example.com      (required; unset = nobody can sign in)
# RESEND_API_KEY=...                  (prod only; without it codes are logged; scripts/set-resend-key.sh pitara)
# KUNJI_SECRET=kjs_...                (from pitara's page in kunji) and KUNJI_URL=... ; unset refuses every kunji call
