# The extension has no env file: scripts/build-extension.sh sets these for the build.
#   VITE_CONVEX_SITE_URL   default: derived from web/.env.prod.local (VITE_CONVEX_URL, .convex.cloud -> .convex.site)
#   EXT_ENV=dev            build against the local backend instead (VITE_CONVEX_SITE_URL from backend/.env.local)
#   VITE_COMMIT            default: `git rev-parse --short HEAD`
