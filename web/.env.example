# ---------------------------------------------------------------------------
# .env.prod.local — git-ignored, read line by line by ../scripts/deploy*.sh, which
# upload dist/ to DEPLOY_DIR on the VPS. (Dev reads ../backend/.env.local.)
# ---------------------------------------------------------------------------
# DEPLOY_HOST=user@your-server
# DEPLOY_PORT=22
# DEPLOY_DIR=/var/www/pitara
# VITE_CONVEX_URL=https://<prod-deployment>.convex.cloud   (only scripts/deploy-web.sh uses it; deploy.sh gets it from Convex)
